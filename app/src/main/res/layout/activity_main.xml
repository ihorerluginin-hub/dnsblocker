<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Остановлен"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Включить блокировку"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:textSize="15sp"
            android:text="Запросов: 0\nЗаблокировано: 0\nДоменов в списке: 0" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Обновить список блокировки" />

        <TextView
            android:id="@+id/tvUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textSize="13sp"
            android:textColor="#666666"
            android:text="Как работает: приложение поднимает локальный VPN, который перехватывает только DNS-запросы. Рекламные и трекерные домены получают пустой ответ (0.0.0.0), остальные прозрачно пересылаются вашему обычному DNS. Root не нужен, трафик не проксируется, батарея не тратится.\n\nОграничения: если в браузере включён «Безопасный DNS» (DoH), он может обходить блокировку — отключите его в настройках браузера. Приложения со своим зашитым DNS-over-TLS к публичным серверам тоже могут пройти мимо (популярные адреса перехватываются)." />
    </LinearLayout>
</ScrollView>
